# Salin file ini menjadi .env.local lalu isi. Penjelasan lengkap tiap variabel: docs/08-ENV.md
# Jangan pernah commit .env.local atau membagikan nilainya.

# =========== WAJIB SEKARANG ===========

# Alamat project Supabase (Supabase > Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=
# Kunci 'anon' / 'publishable' (aman terlihat di browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Kunci 'service_role' / 'secret'. RAHASIA: hanya di server, jangan beri awalan NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Kata sandi acak buatan sendiri (minimal 24 karakter). Dipakai di alamat webhook dari provider.
WEBHOOK_SECRET=
# Kata sandi acak buatan sendiri (minimal 16 karakter). Dipakai oleh jadwal otomatis (cron) Vercel.
CRON_SECRET=

# OPSIONAL, hanya untuk membuat admin pertama dari browser (halaman /setup). Acak, minimal 24 karakter.
# Isi, buka /setup, buat admin, lalu HAPUS variabel ini dari Vercel. Kosong = halaman /setup mati (404).
SETUP_SECRET=

# =========== DISARANKAN ===========

# Alamat situs. Dipakai di tautan email (konfirmasi pendaftaran / reset password).
# Lokal: http://localhost:3000   Produksi: https://toko-kuota.web.id
NEXT_PUBLIC_SITE_URL=

# =========== OPSIONAL ===========

# Isi 1 untuk mengubah pengaman browser (CSP) menjadi mode catat-saja kalau ada halaman yang rusak.
CSP_REPORT_ONLY=

# Notifikasi Telegram untuk admin (opsional; kosong = tidak ada alert)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Admin wajib verifikasi dua langkah. Isi false HANYA untuk pengembangan lokal.
ADMIN_MFA_REQUIRED=

# =========== NANTI (KOSONGKAN DULU) ===========
# Diisi hanya setelah Tahap 2B selesai. Kalau diisi, pembelian benar-benar dikirim ke KhfyPay.
# KHFYPAY_BASE_URL=https://panel.khfy-store.com/api_v2
# KHFYPAY_API_KEY=
# KHFYPAY_TIMEOUT_MS=15000
